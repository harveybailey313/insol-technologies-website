{
  "redirects": [
    {
      "source": "/:path((?:.*/)?[^./]+)",
      "has": [
        {
          "type": "host",
          "value": "insoltechnologies.com"
        }
      ],
      "destination": "https://www.insoltechnologies.com/:path/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "insoltechnologies.com"
        }
      ],
      "destination": "https://www.insoltechnologies.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/industries/financial-services{/}?",
      "destination": "/industries/",
      "statusCode": 301
    },
    {
      "source": "/:path((?:.*/)?[^./]+)",
      "destination": "/:path/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "trailingSlash": true
}