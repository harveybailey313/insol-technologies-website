{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "insoltechnologies.com"
        }
      ],
      "destination": "https://www.insoltechnologies.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "insoltechnologies.com"
        }
      ],
      "destination": "https://www.insoltechnologies.com/",
      "permanent": true
    },
    {
      "source": "/industries/financial-services",
      "destination": "/industries/",
      "permanent": true
    },
    {
      "source": "/industries/financial-services/",
      "destination": "/industries/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
